<?xml version="1.0" encoding="utf-8"?>
<!-- Never let auth cookies leave the device via backup/transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="yt4_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="yt4_auth.xml" />
    </device-transfer>
</data-extraction-rules>
